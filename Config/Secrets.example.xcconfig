// העתק את הקובץ הזה ל-Secrets.xcconfig ומלא את הערכים שלך.
// Secrets.xcconfig לא נשמר ב-git.

// מזהה ייחודי לאפליקציה (שנה ל-שם שלך), למשל com.adam.songmilim
APP_BUNDLE_ID = com.yourname.songmilim

// Team ID מ-developer.apple.com > Membership (10 תווים)
APP_TEAM_ID = ABCDE12345

// Client ID מ-developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID = your_spotify_client_id
